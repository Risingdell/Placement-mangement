# =============================================================
# backend/.env.example — Backend environment template
# =============================================================
# Used for LOCAL development (npm run dev) with XAMPP MySQL.
# NOT used inside Docker — docker-compose injects env vars directly.
#
# HOW TO USE for local dev:
#   1. Copy: cp backend/.env.example backend/.env
#   2. Fill in your XAMPP MySQL password and JWT secret
# =============================================================

# ── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (XAMPP local) ───────────────────────────────────
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=placement_management
DB_PORT=3306

# ── JWT ──────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_EXPIRE=7d

# ── File Uploads ─────────────────────────────────────────────
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# ── CORS ─────────────────────────────────────────────────────
# Vite dev server URL — add port 5174 or 5175 if 5173 is busy
FRONTEND_URL=http://localhost:5173
