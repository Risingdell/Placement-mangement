# =============================================================
# .env.example — Docker Compose environment template
# =============================================================
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Edit .env with your real values
#   3. .env is in .gitignore — never commit it
#
# docker-compose.yml reads these values with ${VAR:-default}
# The ":-default" part means it works even without a .env file
# (uses the fallback value shown after :-).
# =============================================================

# ── Database ─────────────────────────────────────────────────
# Password for the MySQL root user inside the Docker container.
# Change this to something stronger for any shared/cloud environment.
DB_PASSWORD=testpass123

# MySQL database name (created automatically on first run)
DB_NAME=placement_management

# ── JWT Secret ───────────────────────────────────────────────
# Secret key used to sign JWT tokens. MUST be long and random.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Change this before sharing your deployment with anyone.
JWT_SECRET=change-this-to-a-long-random-string-before-deploying

# Frontend URL used in email reset links
FRONTEND_URL=http://localhost:5173

# Email / Resend
RESEND_API_KEY=re_your_resend_api_key
MAIL_FROM=Placement Portal <onboarding@resend.dev>
