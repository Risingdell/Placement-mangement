node_modules

# Backend folder — not needed for frontend build
backend

# Previous build output
dist

# Environment secrets
.env
.env.local
.env.*.local

# Git
.git
.gitignore

# Logs
*.log
npm-debug.log*

# Editor configs
.vscode
.idea
