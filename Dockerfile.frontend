# =============================================================
# Dockerfile.frontend — Multi-stage build for React + nginx
# =============================================================
# "Multi-stage" means this file has TWO FROM instructions.
# Stage 1 builds the app using Node.js.
# Stage 2 copies ONLY the built output into a tiny nginx image.
# The final image contains NO Node.js — just nginx + static files.
# Result: ~25MB image instead of ~300MB.
# =============================================================


# ─────────────────────────────────────────────────────────────
# STAGE 1: "builder" — use Node to compile the React app
# ─────────────────────────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# --- Layer cache trick (same as backend) ---
COPY package*.json ./
RUN npm ci

# Copy all frontend source code
COPY . .

# VITE_API_URL is injected at BUILD TIME as a build argument.
# In docker-compose this is set to /api (relative path) because
# nginx on the same container proxies /api/* to the backend.
# At build time Vite replaces import.meta.env.VITE_API_URL with
# this value in the bundled JavaScript.
ARG VITE_API_URL=/api
ENV VITE_API_URL=$VITE_API_URL

# Build the React app → output goes to /app/dist
RUN npm run build


# ─────────────────────────────────────────────────────────────
# STAGE 2: "server" — tiny nginx image, only static files
# ─────────────────────────────────────────────────────────────
FROM nginx:1.25-alpine

# Copy the built React files from Stage 1 (the "builder" stage)
# Nothing else from Stage 1 comes across — not node_modules, not source
COPY --from=builder /app/dist /usr/share/nginx/html

# Use our custom nginx config (SPA routing + API proxy)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Port 80 inside the container (docker-compose maps this to 3000 on your machine)
EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
